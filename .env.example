# Copy to `.env` (git-ignored) and fill in: `cp .env.example .env`
# The tools/generate-*-env.mjs scripts read `.env` before `nx serve web` / `nx build web`
# and compile these values into the bundle. Every key is optional; each section says what
# happens when it is left unset.

# ── API ──────────────────────────────────────────────────────────────────────
# Base URL of the Rails backend. On a LAN this is the backend machine's IP, which can
# change when the router hands out a new lease — update it here, not in api.env.ts.
# Unset → http://localhost:3000.
API_URL=http://localhost:3000

# ── Google OAuth 2.0 (social sign-in) ────────────────────────────────────────
# GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Add http://localhost:4300 (and your prod domain) to Authorised JavaScript Origins.
GOOGLE_OAUTH_CLIENT_ID=

# TEMPORARY (testing): allow the https WebView origin to call the cleartext LAN API.
# Local machines only — .env is git-ignored, so CI/release keep the secure default.
# ANDROID_ALLOW_MIXED_CONTENT=true

# ── Google Analytics 4 (public marketplace only) ─────────────────────────────
# analytics.google.com → Admin → Data Streams → Web → your stream.
# The MEASUREMENT ID is at the top right, shaped G-XXXXXXXXXX. Not a secret: it ships
# in the client bundle by design. Leave this unset and analytics stay fully off —
# no script, no consent banner, no requests.
# While you are in the console: set Data Retention to 14 months (default is 2, and
# past data cannot be recovered), and leave Google Signals off.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── CARTO basemaps (Leaflet tile layer) ──────────────────────────────────────
# carto.com/basemaps/apikey — email + domain + one line about the project, key
# emailed straight back, no CARTO account needed. Free tier is 5M tile requests a
# month and permits commercial use.
# Not a secret: it ships in the tile URL and is visible in devtools by design. The
# domain allow-list you set when requesting it is what actually protects it, so list
# localhost AND the production domain there.
# Leave unset and the map still works — CARTO just stamps "API KEY REQUIRED" across
# every tile.
CARTO_BASEMAP_KEY=
