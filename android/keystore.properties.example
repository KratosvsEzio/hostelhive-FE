# Copy this file to android/keystore.properties and fill in your values.
# (This .example file is safe to commit; keystore.properties itself is git-ignored.)
# Consumed by android/app/build.gradle for RELEASE signing (gradlew bundleRelease).
#
# First create your upload keystore (one time, keep it + the passwords safe):
#   keytool -genkey -v -keystore hostelhive-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias hostelhive
#
# storeFile is resolved relative to android/app/ (so ../../ points at the repo root).
storeFile=../../hostelhive-upload.jks
storePassword=CHANGE_ME
keyAlias=hostelhive
keyPassword=CHANGE_ME
