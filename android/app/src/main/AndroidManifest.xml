<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!--
          Channel FCM puts an incoming notification on when the payload does not name
          one itself. Without this, Android drops it on a fallback channel of default
          importance: it lands silently in the tray with no heads-up popover and no
          prominence on the lock screen. The channel itself is created at runtime with
          MAX importance (see core/push-notifications.ts) — this only decides which
          channel is used, not how it behaves.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hh_default"
        />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Geolocation ("Near me" on the search map) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Camera — "Take a photo" in the image picker (@capacitor/camera). Declaring the
         permission means the app requests it at runtime before the first capture. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Camera is optional hardware so the app still installs on camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
